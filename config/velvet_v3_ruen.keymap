#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        kp_lang: kp_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPS>;
            label = "KP_LANG";
        };

        to_lang: tog_lang {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp_lang &macro_param_1to1 &to MACRO_PLACEHOLDER>;
            label = "TOG_LANG";
        };

        hold_lang: mt_lang {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&kp_lang>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&kp_lang>;

            label = "MT_LANG";
        };

        mo_ru: mo_ru {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_lang 0>,
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_lang 1>;

            label = "MO_RU";
        };

        kp_double: kp_double {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "KP_DOUBLE";
        };
    };

    behaviors {
        my_n: my_n {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_N";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mt RCTRL N>, <&kp_double N>;
        };

        my_e: my_e {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_E";
            #binding-cells = <0>;
            bindings = <&mt RIGHT_GUI E>, <&kp_double E>;

            tapping-term-ms = <300>;
        };

        my_i: my_i {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_I";
            #binding-cells = <0>;
            bindings = <&mt RIGHT_ALT I>, <&kp_double I>;

            tapping-term-ms = <300>;
        };

        lt_en_lang: lt_en_lang {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_EN_LANG";
            bindings = <&mo>, <&to_lang>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
        };

        mt_ru: mt_ru {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_RU";
            bindings = <&hold_lang>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        lt_ru_lang: lt_ru_lang {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_RU_LANG";
            bindings = <&mo_ru>, <&to_lang>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
        };

        my_o: my_o {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_O";
            #binding-cells = <0>;
            bindings = <&lt 5 O>, <&kp_double O>;

            tapping-term-ms = <300>;
        };

        my_a: my_a {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_A";
            #binding-cells = <0>;
            bindings = <&lt 4 A>, <&kp_double A>;

            tapping-term-ms = <300>;
        };

        my_r: my_r {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_R";
            #binding-cells = <0>;
            bindings = <&mt LALT R>, <&kp_double R>;

            tapping-term-ms = <300>;
        };

        my_s: my_s {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_S";
            #binding-cells = <0>;
            bindings = <&mt LGUI S>, <&kp_double S>;

            tapping-term-ms = <300>;
        };

        my_t: my_t {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_T";
            #binding-cells = <0>;
            bindings = <&mt LCTRL T>, <&kp_double T>;

            tapping-term-ms = <300>;
        };

        my_space: my_space {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_SPACE";
            #binding-cells = <0>;
            bindings = <&mt LSHFT SPACE>, <&kp_double SPACE>;

            tapping-term-ms = <300>;
        };

        my_enter: my_enter {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_ENTER";
            #binding-cells = <0>;
            bindings = <&mt LSHFT ENTER>, <&kp_double ENTER>;

            tapping-term-ms = <300>;
        };

        mo_to: mo_to {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_TO";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
        };

        ru_mo_to: ru_mo_to {
            compatible = "zmk,behavior-hold-tap";
            label = "RU_MO_TO";
            bindings = <&mo_ru>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
        };

        my_ru_a: my_ru_a {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_RU_A";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&lt 4 RU_CYRILLIC_A>, <&kp RU_CYRILLIC_A>;
        };

        my_ru_ya: my_ru_ya {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_RU_YA";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mt_ru LALT RU_CYRILLIC_YA>, <&kp RU_CYRILLIC_YA>;
        };

        my_ru_yeru: my_ru_yeru {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_RU_YERU";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mt_ru LGUI RU_CYRILLIC_YERU>, <&kp RU_CYRILLIC_YERU>;
        };

        my_ru_te: my_ru_te {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_RU_TE";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mt_ru LCTRL RU_CYRILLIC_TE>, <&kp RU_CYRILLIC_TE>;
        };

        my_ru_pe: my_ru_pe {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_RU_PE";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mt_ru RCTRL RU_CYRILLIC_PE>, <&kp RU_CYRILLIC_PE>;
        };

        my_ru_ie: my_ru_ie {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_RU_IE";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mt_ru RGUI RU_CYRILLIC_IE>, <&kp RU_CYRILLIC_IE>;
        };

        my_ru_short_i: my_ru_short_i {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_RU_SHORT_I";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings =
                <&mt_ru RALT RU_CYRILLIC_SHORT_I>,
                <&kp RU_CYRILLIC_SHORT_I>;
        };

        my_ru_o: my_ru_o {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_RU_O";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&lt 5 RU_CYRILLIC_O>, <&kp RU_CYRILLIC_O>;
        };

        // --- SPEC Слой Tap-Dance ---

        my_spec_lt: my_spec_lt {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_SPEC_LT";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&lt 4 LT>, <&kp LT>;
        };

        // --- FN Слой Tap-Dance ---

        my_fn_tab: my_fn_tab {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_FN_TAB";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&lt 4 TAB>, <&kp TAB>;
        };

        my_fn_f4: my_fn_f4 {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_FN_F4";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mt LALT F4>, <&kp F4>;
        };

        my_fn_f5: my_fn_f5 {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_FN_F5";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mt LGUI F5>, <&kp F5>;
        };

        my_fn_f6: my_fn_f6 {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_FN_F6";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mt LCTRL F6>, <&kp F6>;
        };

        my_fn_dot: my_fn_dot {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_FN_DOT";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mt RCTRL DOT>, <&kp DOT>;
        };

        my_fn_comma: my_fn_comma {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_FN_COMMA";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mt RGUI COMMA>, <&kp COMMA>;
        };

        my_fn_colon: my_fn_colon {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_FN_COLON";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mt RALT COLON>, <&kp COLON>;
        };

        my_fn_semi: my_fn_semi {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_FN_SEMI";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&lt 5 SEMI>, <&kp SEMI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&to 0           &none  &kp W      &kp F      &kp P       &kp B                                    &kp J       &kp L     &kp U      &kp Y          &none  &none
&none           &my_a  &my_r      &my_s      &my_t       &kp G                                    &kp M       &my_n     &my_e      &my_i          &my_o  &none
&kp LEFT_ARROW  &none  &kp X      &kp C      &kp D       &kp V                                    &kp K       &kp H     &kp Z      &kp Q          &none  &kp RIGHT_ARROW
                       &kp LG(C)  &kp LG(V)  &kp DELETE  &lt_en_lang 3 1  &my_space    &my_enter  &mo_to 2 0  &kp BSPC  &kp LG(Z)  &kp LS(LG(Z))
            >;

            display-name = "Base";
        };

        ru {
            display-name = "Ru";
            bindings = <
&trans  &kp RU_CYRILLIC_TSE  &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_EF  &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_BE                     &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_EL  &kp RU_CYRILLIC_I   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_HARD_SIGN
&trans  &my_ru_a             &my_ru_ya            &my_ru_yeru         &my_ru_te           &kp RU_CYRILLIC_GHE                    &kp RU_CYRILLIC_EM   &my_ru_pe           &my_ru_ie           &my_ru_short_i      &my_ru_o                   &kp RU_CYRILLIC_E
&trans  &kp RU_CYRILLIC_CHE  &kp RU_CYRILLIC_HA   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_DE  &kp RU_CYRILLIC_VE                     &kp RU_CYRILLIC_KA   &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_ZE  &kp RU_CYRILLIC_YU  &kp RU_CYRILLIC_SHCHA      &trans
                             &trans               &trans              &trans              &lt_ru_lang 3 0      &trans    &trans  &ru_mo_to 2 0        &trans              &trans              &trans
            >;
        };

        spec {
            bindings = <
&trans  &kp GT       &kp RBKT   &kp RPAR   &kp RBRC  &kp DQT                      &trans        &kp K_VOL_DN      &kp K_VOL_UP   &kp C_MUTE       &trans          &trans
&trans  &my_spec_lt  &kp LBKT   &kp LPAR   &kp LBRC  &kp APOS                     &out OUT_USB  &mt RCTRL C_PREV  &mt RGUI C_PP  &mt RALT C_NEXT  &lt 5 PSCRN     &trans
&trans  &kp AT       &kp UNDER  &kp PRCNT  &kp DLLR  &kp GRAVE                    &out OUT_BLE  &bt BT_SEL 0      &bt BT_SEL 1   &bt BT_SEL 2     &bt BT_CLR_ALL  &trans
                     &trans     &trans     &trans    &mo 3      &trans    &trans  &mo 2         &trans            &trans         &trans
            >;
        };

        fn {
            bindings = <
&trans  &kp ESC     &kp F7     &kp F8     &kp F9     &kp F10                    &kp CARET  &kp MINUS   &kp PLUS      &kp EQUAL     &kp ASTRK    &trans
&trans  &my_fn_tab  &my_fn_f4  &my_fn_f5  &my_fn_f6  &kp F11                    &kp FSLH   &my_fn_dot  &my_fn_comma  &my_fn_colon  &my_fn_semi  &kp NUBS
&trans  &trans      &kp F1     &kp F2     &kp F3     &kp F12                    &kp HASH   &kp EXCL    &kp QMARK     &kp AMPS      &kp PIPE     &trans
                    &trans     &trans     &trans     &mo 3    &trans    &trans  &mo 2      &trans      &trans        &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp RC(END)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans         &trans       &trans       &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans         &trans       &trans
            >;
        };

        num {
            bindings = <
&trans  &trans  &kp N7  &kp N8  &kp N9  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N0  &kp N4  &kp N5  &kp N6  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp N1  &kp N2  &kp N3  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
