#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        tolang: toru {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp LC(SPACE) &macro_param_1to1 &to MACRO_PLACEHOLDER>;
            label = "TORU";
        };

        ruen: ruen {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&kp LC(SPACE)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&kp LC(SPACE)>,
                <&macro_press>;

            label = "RUEN";
        };

        repit: repit {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "REPIT";
        };

        rumt: new_macr {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_2to2 &mt MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to 0>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_2to2 &mt MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to 1>,
                <&macro_press>;

            label = "NEW_MACR";
        };
    };

    behaviors {
        my_n: my_n {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_N";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mt RCTRL N>, <&kp N>;
        };

        my_e: my_e {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_E";
            #binding-cells = <0>;
            bindings = <&mt RIGHT_GUI E>, <&kp E>;

            tapping-term-ms = <300>;
        };

        my_i: my_i {
            compatible = "zmk,behavior-tap-dance";
            label = "MY_I";
            #binding-cells = <0>;
            bindings = <&mt RIGHT_ALT I>, <&kp I>;

            tapping-term-ms = <300>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&to 0           &none    &kp W       &kp F       &kp P          &kp B                                      &kp J  &kp L        &kp U       &kp Y          &none    &none
&tolang 1       &lt 3 A  &mt LALT R  &mt LGUI S  &mt LCTRL T    &kp G                                      &kp M  &mt RCTRL N  &mt RGUI E  &mt RALT I     &lt 2 O  &none
&kp LEFT_ARROW  &none    &kp X       &kp C       &kp D          &kp V                                      &kp K  &kp H        &kp Z       &kp Q          &none    &kp RIGHT_ARROW
                         &kp LG(C)   &kp LG(V)   &kp BACKSPACE  &mo 4  &mt LSHFT SPACE    &mt RSHFT ENTER  &mo 5  &kp DELETE   &kp LG(Z)   &kp LS(LG(Z))
            >;

            display-name = "Base";
        };

        ru {
            display-name = "Ru";
            bindings = <
&trans     &kp RU_CYRILLIC_TSE  &kp RU_CYRILLIC_SHA            &kp RU_CYRILLIC_EF           &kp RU_CYRILLIC_ER          &kp RU_CYRILLIC_BE                     &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_EL          &kp RU_CYRILLIC_I          &kp RU_CYRILLIC_U                    &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_HARD_SIGN
&tolang 0  &lt 3 RU_CYRILLIC_A  &rumt LEFT_ALT RU_CYRILLIC_YA  &rumt LGUI RU_CYRILLIC_YERU  &rumt LCTRL RU_CYRILLIC_TE  &kp RU_CYRILLIC_GHE                    &kp RU_CYRILLIC_EM   &rumt RCTRL RU_CYRILLIC_PE  &rumt RGUI RU_CYRILLIC_IE  &rumt RIGHT_ALT RU_CYRILLIC_SHORT_I  &lt 2 RU_CYRILLIC_O        &kp RU_CYRILLIC_E
&trans     &kp RU_CYRILLIC_CHE  &kp RU_CYRILLIC_HA             &kp RU_CYRILLIC_ES           &kp RU_CYRILLIC_DE          &kp RU_CYRILLIC_VE                     &kp RU_CYRILLIC_KA   &kp RU_CYRILLIC_EN          &kp RU_CYRILLIC_ZE         &kp RU_CYRILLIC_YU                   &kp RU_CYRILLIC_SHCHA      &trans
                                &trans                         &trans                       &trans                      &ruen 4              &trans    &trans  &ruen 5              &trans                      &trans                     &trans
            >;
        };

        num {
            bindings = <
&trans  &trans  &kp N7  &kp N8  &kp N9  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N0  &kp N4  &kp N5  &kp N6  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp N1  &kp N2  &kp N3  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp RC(END)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LEFT  &kp DOWN       &kp UP       &kp LEFT     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans         &trans       &trans       &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans         &trans       &trans
            >;
        };

        spec {
            bindings = <
&trans  &kp GT  &kp RBKT   &kp RPAR   &kp RBRC  &kp DQT                      &trans        &kp C_VOL_DN  &kp C_VOL_UP  &kp K_MUTE    &trans          &trans
&trans  &kp LT  &kp LBKT   &kp LPAR   &kp LBRC  &kp APOS                     &out OUT_USB  &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp PSCRN       &trans
&trans  &kp AT  &kp UNDER  &kp PRCNT  &kp DLLR  &kp GRAVE                    &out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR_ALL  &trans
                &trans     &trans     &trans    &trans     &trans    &trans  &trans        &trans        &trans        &trans
            >;
        };

        fn {
            bindings = <
&trans  &kp ESC  &kp F7  &kp F8  &kp F9  &kp F10                    &kp CARET  &kp MINUS  &kp PLUS   &kp EQUAL  &kp ASTRK  &trans
&trans  &kp TAB  &kp F4  &kp F5  &kp F6  &kp F11                    &kp FSLH   &kp DOT    &kp COMMA  &kp COLON  &kp SEMI   &kp NUBS
&trans  &trans   &kp F1  &kp F2  &kp F3  &kp F12                    &kp HASH   &kp EXCL   &kp QMARK  &kp AMPS   &kp PIPE   &trans
                 &trans  &trans  &trans  &trans   &trans    &trans  &trans     &trans     &trans     &trans
            >;
        };
    };
};
