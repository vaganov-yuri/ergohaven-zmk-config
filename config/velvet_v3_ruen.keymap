#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        tolang: toru {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp LC(SPACE) &macro_param_1to1 &to MACRO_PLACEHOLDER>;
            label = "TORU";
        };

        ruen: ruen {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&kp LC(SPACE)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&kp LC(SPACE)>,
                <&macro_press>;

            label = "RUEN";
        };

        repit: repit {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "REPIT";
        };

        rumt: new_macr {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_2to2 &mt MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to 0>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_2to2 &mt MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to 1>,
                <&macro_press>;

            label = "NEW_MACR";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&to 0           &none  &kp W       &kp F       &kp P          &kp B                                      &kp J  &kp L        &kp U       &kp Y          &none  &none
&tolang 1       &kp A  &mt LALT R  &mt LGUI S  &mt LCTRL T    &kp G                                      &kp M  &mt RCTRL N  &mt RGUI E  &mt RALT I     &kp O  &none
&kp LEFT_ARROW  &none  &kp X       &kp C       &kp D          &kp V                                      &kp K  &kp H        &kp Z       &kp Q          &none  &kp RIGHT_ARROW
                       &kp LG(C)   &kp LG(V)   &kp BACKSPACE  &mo 2  &mt LSHFT SPACE    &mt RSHFT ENTER  &mo 3  &kp DELETE   &kp LG(Z)   &kp LS(LG(Z))
            >;

            display-name = "Base";
        };

        ru {
            display-name = "Ru";
            bindings = <
&trans     &kp RU_CYRILLIC_TSE  &kp RU_CYRILLIC_SHA            &kp RU_CYRILLIC_EF           &kp RU_CYRILLIC_ER          &kp RU_CYRILLIC_BE                     &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_EL          &kp RU_CYRILLIC_I          &kp RU_CYRILLIC_U                    &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_HARD_SIGN
&tolang 0  &kp RU_CYRILLIC_A    &rumt LEFT_ALT RU_CYRILLIC_YA  &rumt LGUI RU_CYRILLIC_YERU  &rumt LCTRL RU_CYRILLIC_TE  &kp RU_CYRILLIC_GHE                    &kp RU_CYRILLIC_EM   &rumt RCTRL RU_CYRILLIC_PE  &rumt RGUI RU_CYRILLIC_IE  &rumt RIGHT_ALT RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_E
&trans     &kp RU_CYRILLIC_CHE  &kp RU_CYRILLIC_HA             &kp RU_CYRILLIC_ES           &kp RU_CYRILLIC_DE          &kp RU_CYRILLIC_VE                     &kp RU_CYRILLIC_KA   &kp RU_CYRILLIC_EN          &kp RU_CYRILLIC_ZE         &kp RU_CYRILLIC_YU                   &kp RU_CYRILLIC_SHCHA      &trans
                                &trans                         &trans                       &trans                      &ruen 2              &trans    &trans  &ruen 3              &trans                      &trans                     &trans
            >;
        };

        layer_2 {
            bindings = <
&none  &none   &kp N7  &kp N8  &kp N9  &none                     &none     &kp MINUS  &kp EQUAL  &kp GRAVE  &none     &none
&none  &kp N0  &kp N4  &kp N5  &kp N6  &none                     &kp FSLH  &kp COMMA  &kp DOT    &kp APOS   &kp SEMI  &none
&none  &none   &kp N1  &kp N2  &kp N3  &none                     &none     &kp LBKT   &kp RBKT   &kp BSLH   &none     &none
               &none   &none   &trans  &trans  &trans    &trans  &none     &trans     &none      &none
            >;
        };

        layer_3 {
            bindings = <
&none  &kp ESC  &kp F7  &kp F8  &kp F9  &kp F12                    &kp RC(LEFT)  &repit DOWN     &repit UP    &kp RC(RIGHT)   &none  &none
&none  &kp TAB  &kp F4  &kp F5  &kp F6  &kp F11                    &kp LEFT      &mt RCTRL DOWN  &mt RCMD UP  &mt RALT RIGHT  &none  &none
&none  &none    &kp F1  &kp F2  &kp F3  &kp F10                    &kp HOME      &kp PAGE_DOWN   &kp PAGE_UP  &kp END         &none  &none
                &none   &none   &trans  &none    &trans    &trans  &trans        &trans          &none        &none
            >;
        };
    };
};
