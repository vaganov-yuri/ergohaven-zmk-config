#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        kp_lang: kp_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPS>;
            label = "KP_LANG";
            wait-ms = <2>;
            tap-ms = <2>;
        };

        to_lang: tog_lang {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp_lang &macro_param_1to1 &to MACRO_PLACEHOLDER>;
            label = "TOG_LANG";
            wait-ms = <2>;
            tap-ms = <2>;
        };

        hold_ru: mt_lang {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&mo 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&kp_lang>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&kp_lang>;

            label = "MT_LANG";
            wait-ms = <10>;
            tap-ms = <10>;
        };

        mo_ru: mo_ru {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&kp_lang>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&kp_lang>;

            label = "MO_RU";
            wait-ms = <2>;
            tap-ms = <2>;
        };

        kp_double: kp_double {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "KP_DOUBLE";
            wait-ms = <2>;
            tap-ms = <2>;
        };

        mo_lang: mo_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp_lang>,
                <&macro_press>,
                <&mo 1>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 1>,
                <&macro_tap>,
                <&kp_lang>;

            label = "MO_LANG";
            wait-ms = <2>;
            tap-ms = <2>;
        };
    };

    behaviors {
        mt_ru: mt_ru {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_RU";
            bindings = <&hold_ru>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
        };

        lt_ru: lt_ru {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_RU";
            bindings = <&mo_ru>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };

        mo_to: mo_to {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_TO";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
        };

        ru_mo_to: ru_mo_to {
            compatible = "zmk,behavior-hold-tap";
            label = "RU_MO_TO";
            bindings = <&mo_ru>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        ru {
            display-name = "Ru";
            bindings = <
&to 0       &kp RU_CYRILLIC_TSE        &kp RU_CYRILLIC_SHA         &kp RU_CYRILLIC_EF             &kp RU_CYRILLIC_ER        &kp RU_CYRILLIC_BE                               &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_EL        &kp RU_CYRILLIC_I            &kp RU_CYRILLIC_U                &kp RU_CYRILLIC_SHCHA      &kp RU_CYRILLIC_HARD_SIGN
&to_lang 1  &mt_ru LGUI RU_CYRILLIC_A  &mt_ru LALT RU_CYRILLIC_YA  &mt_ru LCTRL RU_CYRILLIC_YERU  &mt LSHFT RU_CYRILLIC_TE  &kp RU_CYRILLIC_GHE                              &kp RU_CYRILLIC_EM   &mt RSHFT RU_CYRILLIC_PE  &mt_ru RCTRL RU_CYRILLIC_IE  &mt_ru RALT RU_CYRILLIC_SHORT_I  &mt_ru RGUI RU_CYRILLIC_O  &kp RU_CYRILLIC_E
&kp LEFT    &kp RU_CYRILLIC_CHE        &kp RU_CYRILLIC_HA          &kp RU_CYRILLIC_ES             &kp RU_CYRILLIC_DE        &kp RU_CYRILLIC_VE                               &kp RU_CYRILLIC_KA   &kp RU_CYRILLIC_EN        &kp RU_CYRILLIC_ZE           &kp RU_CYRILLIC_YU               &kp RU_CYRILLIC_SOFT_SIGN  &kp RIGHT
                                       &kp LC(C)                   &kp LC(V)                      &kp DELETE                &lt_ru 3 TAB         &lt 4 SPACE    &lt 5 ENTER  &lt_ru 3 ESC         &kp BACKSPACE             &kp RC(Z)                    &kp RC(RS(Z))
            >;
        };

        en {
            bindings = <
&trans      &none       &kp W       &kp F        &kp P        &kp B                        &kp J      &kp L        &kp U        &kp Y       &none       &none
&to_lang 0  &mt LGUI A  &mt LALT R  &mt LCTRL S  &mt LSHFT T  &kp G                        &kp M      &mt RSHFT N  &mt RCTRL E  &mt RALT I  &mt RGUI O  &none
&trans      &none       &kp X       &kp C        &kp D        &kp V                        &kp K      &kp H        &kp Z        &kp Q       &none       &trans
                        &trans      &trans       &trans       &lt 3 TAB  &trans    &trans  &lt 2 ESC  &trans       &trans       &trans
            >;

            display-name = "Base";
        };

        spec {
            bindings = <
&trans     &kp GT  &kp RBKT   &kp RPAR   &kp RBRC  &kp GRAVE                    &trans        &kp K_VOL_DN  &kp K_VOL_UP    &kp C_MUTE       &trans          &trans
&kp TILDE  &kp LT  &kp LBKT   &kp LPAR   &kp LBRC  &kp APOS                     &out OUT_USB  &kp C_PREV    &mt RCTRL C_PP  &mt RALT C_NEXT  &mt RGUI PSCRN  &trans
&trans     &kp AT  &kp UNDER  &kp PRCNT  &kp DLLR  &kp DQT                      &out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_CLR_ALL  &trans
                   &trans     &trans     &trans    &trans     &trans    &trans  &trans        &trans        &trans          &trans
            >;
        };

        fn {
            bindings = <
&trans  &trans        &kp F7       &kp F8        &kp F9        &kp F10                    &kp CARET  &kp MINUS      &kp PLUS         &kp EQUAL       &kp ASTRK      &trans
&none   &mt LGUI TAB  &mt LALT F4  &mt LCTRL F5  &mt LSHFT F6  &kp F11                    &kp FSLH   &mt RSHFT DOT  &mt RCTRL COMMA  &mt RALT COLON  &mt RGUI SEMI  &kp BSLH
&trans  &trans        &kp F1       &kp F2        &kp F3        &kp F12                    &kp HASH   &kp EXCL       &kp QMARK        &kp AMPS        &kp PIPE       &trans
                      &trans       &trans        &trans        &trans   &trans    &trans  &trans     &trans         &trans           &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans         &trans       &trans     &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans         &trans
            >;
        };

        num {
            bindings = <
&trans  &kp N0  &kp N7  &kp N8  &kp N9  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N0  &kp N4  &kp N5  &kp N6  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N0  &kp N1  &kp N2  &kp N3  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
